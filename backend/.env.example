# .env.example — copy to .env and fill in real values
APP_NAME="SV AI Trading Platform"
DEBUG=true
DATABASE_URL=postgresql://svuser:svpass@localhost:5432/svtrading
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
JWT_SECRET_KEY=replace-with-a-strong-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]

# Market data provider: "simulated" | "upstox"
MARKET_DATA_PROVIDER=simulated

# Upstox API credentials (required when MARKET_DATA_PROVIDER=upstox)
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/upstox/callback

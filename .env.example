# SV AI Trading Platform — Production Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# === Required ===
POSTGRES_USER=svuser
POSTGRES_PASSWORD=generate-a-strong-random-password-here
POSTGRES_DB=svtrading
DATABASE_URL=postgresql://svuser:YOUR_PG_PASSWORD@postgres:5432/svtrading

JWT_SECRET_KEY=generate-a-strong-random-string-at-least-64-chars
CORS_ORIGINS=["http://localhost","http://YOUR_SERVER_IP"]

# === Market Data ===
# Options: simulated | upstox
MARKET_DATA_PROVIDER=simulated

# === Upstox API (fill when using real market data) ===
UPSTOX_ACCESS_TOKEN=
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/upstox/callback

# === Redis / Celery (leave defaults) ===
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
